{
  "name": "magicite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A from-scratch rebuild of Magicite: a 2D pixel-art roguelike platformer with crafting.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run test",
    "relay": "bun server/relay.ts",
    "server": "bun server/dedicated.ts",
    "e2e:mp": "bun scripts/mp-e2e.ts"
  },
  "dependencies": {
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0",
    "simplex-noise": "^4.0.3",
    "trystero": "^0.25.4",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "playwright-core": "1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
